# Create .env file and copy this content to it, put .env file in the same folder as docker-compose.worker.yml.

DEBUG=1
SECRET_KEY=

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

MAPPING_API_PORT=8000
MAPPING_REDIS_PORT=6379

ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Authenticate Swagger
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Username and password for super admin
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

APP_NAME="SnapFeed"

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://snapfeed.work.gd/api/v1/auth/google/callback
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# Facebook OAuth2
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://snapfeed.work.gd/api/v1/auth/facebook/callback
FACEBOOK_TOKEN_URL=https://graph.facebook.com/v18.0/oauth/access_token
FACEBOOK_USERINFO_URL=https://graph.facebook.com/me

CLIENT_HOMEPAGE_URL=https://snapfeed.work.gd/

# AWS S3
AWS_STORAGE_BUCKET_NAME=
AWS_DEFAULT_REGION=

# API key
API_KEY=

MAPPING_UI_PORT=3000