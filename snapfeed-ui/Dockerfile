FROM node:24.13.0-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_API_URL
ARG VITE_DEFAULT_LANG
ARG VITE_FACEBOOK_APP_ID
ARG VITE_FACEBOOK_AUTH_URL
ARG VITE_FACEBOOK_REDIRECT_URI
ARG VITE_GOOGLE_AUTH_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_REDIRECT_URI
ARG VITE_S3_BUCKET_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_DEFAULT_LANG=$VITE_DEFAULT_LANG
ENV VITE_FACEBOOK_APP_ID=$VITE_FACEBOOK_APP_ID
ENV VITE_FACEBOOK_AUTH_URL=$VITE_FACEBOOK_AUTH_URL
ENV VITE_FACEBOOK_REDIRECT_URI=$VITE_FACEBOOK_REDIRECT_URI
ENV VITE_GOOGLE_AUTH_URL=$VITE_GOOGLE_AUTH_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_REDIRECT_URI=$VITE_GOOGLE_REDIRECT_URI
ENV VITE_S3_BUCKET_URL=$VITE_S3_BUCKET_URL

RUN npm run build


FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]